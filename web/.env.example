# Local: Supabase por el proxy de Vite (ver vite.config.ts)
VITE_SUPABASE_URL=/supabase
# Sale de `npx supabase status` (PUBLISHABLE_KEY). Nunca pongas la secret / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clave pública VAPID (la privada va en supabase/functions/.env)
VITE_VAPID_PUBLIC_KEY=
